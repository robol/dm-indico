POSTGRES_SERVER=postgres
POSTGRES_USER=indico
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=indico

# Make sure to use an https endpoint, unless this is 
# a testing deployment. 
INDICO_BASE_URL=http://localhost
INDICO_SUPPORT_EMAIL=admin@example.com
INDICO_NOREPLY_EMAIL=noreply@example.com

INDICO_REDIS_SERVER=redis
INDICO_SMTP_SERVER=smtp.example.com

# Optional environment variables. If not set, the
# default values listed here are used.
# INDICO_TIMEZONE=Europe/Rome
# INDICO_LOCALE=en_GB
# INDICO_ROOMBOOKING=false
# INDICO_SMTP_PORT=25
# INDICO_SMTP_LOGIN=
# INDICO_SMTP_PASSWORD=
OAUTH2_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxx
OAUTH2_CLIENT_SECRET=yyyyyyyyyyyyyyyyyyyyyy
OAUTH2_SCOPES="openid user email"
OAUTH2_JWKS_URI="https://iam.unipi.it/oauth2/jwks"
OAUTH2_AUTHORIZE_URI="https://iam.unipi.it/oauth2/authorize"
OAUTH2_ACCESS_TOKEN_URI="https://iam.unipi.it/oauth2/token"
OAUTH2_USERINFO_URI="https://iam.unipi.it/oauth2/userinfo"

